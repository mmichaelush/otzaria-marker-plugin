{
  "schemaVersion": 1,
  "id": "com.otzaria-marker",
  "name": "מרקר",
  "version": "0.9.3",
  "description": "סימון טקסט בצבעים מתפריט מקש ימני וניהול כל ההדגשות בצורה נוחה במקום אחד.",
  "author": "מיכאלוש",
  "stability": "stable",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "minAppVersion": "0.9.96",
  "sdkVersion": "1.x",
  "permissions": [
    "app.run_on_startup",
    "ui.feedback",
    "reader.open",
    "reader.context_menu",
    "reader.highlight",
    "plugin.storage.read",
    "plugin.storage.write",
    "fs.user_files.read",
    "events.subscribe:reader.selection_changed",
    "events.subscribe:reader.current_ref_changed",
    "events.subscribe:reader.sectionContentChanged",
    "events.subscribe:navigation.changed",
    "events.subscribe:theme.changed",
    "events.subscribe:plugin.permissions_changed"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "background": {
      "entrypoint": "background.html"
    },
    "toolTab": {
      "title": "מרקר",
      "order": 300,
      "defaultPinned": true,
      "iconName": "highlight_24_regular"
    }
  }
}
